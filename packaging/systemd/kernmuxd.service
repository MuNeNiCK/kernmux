[Unit]
Description=Kernmux Multikernel host management service
Documentation=https://github.com/kernmux/kernmux
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/kernmuxd
EnvironmentFile=-/etc/kernmux/kernmuxd.env
User=root
Group=kernmux
RuntimeDirectory=kernmux
RuntimeDirectoryMode=0750
StateDirectory=kernmux kernmux/images
StateDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
LimitNOFILE=4096

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths=/run/kernmux /var/lib/kernmux /sys/fs/multikernel

[Install]
WantedBy=multi-user.target
