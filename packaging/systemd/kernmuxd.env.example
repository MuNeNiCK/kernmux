# Local API socket. The service group controls filesystem-level admission;
# request authorization still uses the explicit UID/GID policy below.
KERNMUX_SOCKET_PATH=/run/kernmux/kernmuxd.sock
KERNMUX_SOCKET_MODE=0660

# Comma-separated numeric identities. Root UID 0 is always administrator.
KERNMUX_READER_UIDS=
KERNMUX_OPERATOR_UIDS=
KERNMUX_ADMINISTRATOR_UIDS=
KERNMUX_READER_GIDS=
KERNMUX_OPERATOR_GIDS=
KERNMUX_ADMINISTRATOR_GIDS=
# Comma-separated local group names are resolved from /etc/group at startup.
KERNMUX_READER_GROUPS=
KERNMUX_OPERATOR_GROUPS=kernmux
KERNMUX_ADMINISTRATOR_GROUPS=kernmux-admin
KERNMUX_ALLOW_UNPRIVILEGED_READS=false

# Colon-separated administrator-controlled directories containing kernels and
# initrds. Files are canonicalized and must remain inside one of these roots.
KERNMUX_IMAGE_ROOTS=/boot:/var/lib/kernmux/images

# Immutable content-addressed artifact storage and the maximum size accepted
# for one imported kernel or initrd.
KERNMUX_IMAGE_STORE_ROOT=/var/lib/kernmux/images/store
KERNMUX_MAX_IMAGE_BYTES=4294967296

# Release compatibility contract. When configured, kernmuxd collects
# read-only host evidence at startup and exposes the result through host
# preflight. Missing, malformed, or unobservable evidence fails closed.
KERNMUX_COMPATIBILITY_MANIFEST=/etc/kernmux/release.json

# Bounded daemon resources.
KERNMUX_MAX_CONNECTIONS=64
KERNMUX_MAX_MUTATIONS=4
KERNMUX_MAX_CONSOLES=8
KERNMUX_MAX_REQUEST_BYTES=1048576
KERNMUX_MAX_HEADER_BYTES=32768
